<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<EngineRootPath>../engine</EngineRootPath>
	</PropertyGroup>

	<Import Project="$(EngineRootPath)/Directory.Build.props" />

	<ItemGroup>
		<ProjectReference Include="$(EngineRootPath)/OpenRA.Game/OpenRA.Game.csproj">
			<Private>False</Private>
		</ProjectReference>

		<ProjectReference Include="$(EngineRootPath)/OpenRA.Mods.Common/OpenRA.Mods.Common.csproj">
			<Private>False</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<!-- Test map scripts the asset installer writes on converted maps (AssetInstaller/TestMaps.cs). -->
		<EmbeddedResource Include="AssetInstaller/MapTemplates/**/*" LogicalName="MapTemplates/%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- The Menu buttons' fonts (AssetInstaller/MenuButtons.cs; SIL Open Font License, beside each font). -->
		<EmbeddedResource Include="AssetInstaller/Fonts/*.ttf" LogicalName="Fonts/%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(EngineRootPath)/AUTHORS">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
