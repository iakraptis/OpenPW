## world.yaml
faction-random =
    .name = Random
    .description = Random Faction
     A random faction will be chosen when the game starts.

faction-primitive =
    .name = Primitive
    .description = Primitive tribe
     Humans of the stone age: workers, soldiers and war machines, equipped by the Blacksmith.

faction-tyrano =
    .name = Tyrano
    .description = Tyrano tribe
     Mutated dinosaurs: some combine into stronger creatures, some can pass for wild ones.

faction-elf =
    .name = Elf
    .description = Elf tribe
     Masters of magic: weak at close quarters, they strike from afar with their spells.

faction-demon =
    .name = Demon
    .description = Demon tribe
     Born of evil: their life is their kill points, spent on dark spells and won back by killing.

